{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["CMS_URL", "NEXT_PUBLIC_CMS_URL", "CMS_TOKEN", "PORT"],
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
